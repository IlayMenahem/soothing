import FactorBranching.Basic

/-!
# Leading monomials

The leading-monomial ideal `⟨LM(q) : q ∈ Q⟩` (Preliminaries, "Monomial orders and Gröbner bases")
and the divisibility facts about leading monomials that the termination proofs use.
-/

open MvPolynomial

noncomputable section

open scoped Classical

namespace FactorBranching

variable {K : Type*} [Field K] {σ : Type*} (m : MonomialOrder σ)

/-- The ideal `⟨LM(q) : q ∈ Q⟩` generated by the leading monomials of `Q`. -/
def lmIdeal (Q : Finset (MvPolynomial σ K)) : Ideal (MvPolynomial σ K) :=
  Ideal.span ((fun d => monomial d (1 : K)) '' (m.degree '' (↑Q : Set (MvPolynomial σ K))))

variable {m}

/-- A monomial lies in a monomial ideal iff some generator divides it. -/
theorem monomial_mem_lmIdeal {Q : Finset (MvPolynomial σ K)} {d : σ →₀ ℕ} :
    monomial d (1 : K) ∈ lmIdeal m Q ↔ ∃ q ∈ Q, m.degree q ≤ d := by
  rw [lmIdeal, mem_ideal_span_monomial_image]
  simp [support_monomial]

theorem lmIdeal_le_iff {Q Q' : Finset (MvPolynomial σ K)} :
    lmIdeal m Q ≤ lmIdeal m Q' ↔ ∀ q ∈ Q, ∃ q' ∈ Q', m.degree q' ≤ m.degree q := by
  constructor
  · intro h q hq
    exact monomial_mem_lmIdeal.mp (h (Ideal.subset_span ⟨m.degree q, ⟨q, hq, rfl⟩, rfl⟩))
  · intro h
    rw [lmIdeal, Ideal.span_le]
    rintro _ ⟨_, ⟨q, hq, rfl⟩, rfl⟩
    exact monomial_mem_lmIdeal.mpr (h q hq)

/-- `f ∣ g` implies `LM(f) ∣ LM(g)`. -/
theorem degree_le_of_dvd {f g : MvPolynomial σ K} (hfg : f ∣ g) (hg : g ≠ 0) :
    m.degree f ≤ m.degree g := by
  obtain ⟨k, rfl⟩ := hfg
  rw [m.degree_mul (left_ne_zero_of_mul hg) (right_ne_zero_of_mul hg)]
  exact le_self_add

/-- A monic divisor of a monic polynomial with the same leading monomial is that polynomial: the
cofactor is a constant, and both leading coefficients are `1`. -/
theorem eq_of_dvd_of_degree_le {f g : MvPolynomial σ K} (hf : m.Monic f) (hg : m.Monic g)
    (hfg : f ∣ g) (hdeg : m.degree g ≤ m.degree f) : f = g := by
  obtain ⟨k, rfl⟩ := hfg
  have hk : k ≠ 0 := right_ne_zero_of_mul hg.ne_zero
  have hdk : m.degree k = 0 := by
    rw [m.degree_mul hf.ne_zero hk] at hdeg
    exact le_zero_iff.mp ((add_le_iff_nonpos_right _).mp hdeg)
  have hkC := m.eq_C_of_degree_eq_zero hdk
  have hc : m.leadingCoeff k ≠ 0 := m.leadingCoeff_ne_zero_iff.mpr hk
  have hlc : m.leadingCoeff (f * k) = m.leadingCoeff k := by
    rw [m.leadingCoeff_mul_of_mul_leadingCoeff_ne_zero, hf.leadingCoeff_eq_one, one_mul]
    rw [hf.leadingCoeff_eq_one, one_mul]
    exact hc
  have h1 : m.leadingCoeff k = 1 := hlc.symm.trans hg.leadingCoeff_eq_one
  rw [hkC, h1, C_1, mul_one]

theorem eq_of_associated_of_monic {f g : MvPolynomial σ K} (hf : m.Monic f) (hg : m.Monic g)
    (hfg : Associated f g) : f = g :=
  eq_of_dvd_of_degree_le hf hg hfg.dvd (degree_le_of_dvd hfg.symm.dvd hf.ne_zero)

theorem monic_pow {f : MvPolynomial σ K} (hf : m.Monic f) (n : ℕ) : m.Monic (f ^ n) := by
  induction n with
  | zero => simp
  | succ n ih => simpa [pow_succ] using ih.mul hf

end FactorBranching
