import Mathlib

/-!
# Basic setup

The paper (Section "Preliminaries and notation") works in `R = K[x₁,…,xₙ]` and takes solutions in
the algebraic closure `K̄`. Here `R = MvPolynomial σ K` and solutions live in an arbitrary
algebraically closed `K`-algebra `L`.

A finite system is a `Finset` of polynomials, read as the equations `q = 0`.
-/

open MvPolynomial

noncomputable section

open scoped Classical

namespace FactorBranching

variable {K : Type*} [Field K] {σ : Type*}

/-- The solution set `V(Q) = {a ∈ Lⁿ : q(a) = 0 for every q ∈ Q}`. -/
def V (L : Type*) [CommRing L] [Algebra K L] (Q : Set (MvPolynomial σ K)) : Set (σ → L) :=
  {a | ∀ q ∈ Q, aeval a q = 0}

section V

variable {L : Type*} [CommRing L] [Algebra K L]

theorem mem_V {Q : Set (MvPolynomial σ K)} {a : σ → L} : a ∈ V L Q ↔ ∀ q ∈ Q, aeval a q = 0 :=
  Iff.rfl

/-- A point `a` lies in `V(Q)` iff the kernel of evaluation at `a` contains `Q`. -/
theorem mem_V_iff_subset_ker {Q : Set (MvPolynomial σ K)} {a : σ → L} :
    a ∈ V L Q ↔ Q ⊆ RingHom.ker (aeval a : MvPolynomial σ K →ₐ[K] L) := by
  simp [mem_V, Set.subset_def, RingHom.mem_ker]

/-- `V(Q)` only depends on the ideal generated by `Q`. -/
theorem V_eq_zeroLocus (Q : Set (MvPolynomial σ K)) :
    V L Q = {a : σ → L | ∀ p ∈ Ideal.span Q, aeval a p = 0} := by
  ext a
  simp only [mem_V, Set.mem_ofPred_eq]
  refine ⟨fun h p hp => ?_, fun h q hq => h q (Ideal.subset_span hq)⟩
  have : Ideal.span Q ≤ RingHom.ker (aeval a : MvPolynomial σ K →ₐ[K] L) :=
    Ideal.span_le.mpr fun q hq => by simpa [RingHom.mem_ker] using h q hq
  simpa [RingHom.mem_ker] using this hp

theorem V_congr_span {Q Q' : Set (MvPolynomial σ K)} (h : Ideal.span Q = Ideal.span Q') :
    V L Q = V L Q' := by
  rw [V_eq_zeroLocus, V_eq_zeroLocus, h]

/-- Evaluation at a point of a domain has a prime kernel. -/
instance isPrime_ker_aeval [IsDomain L] (a : σ → L) :
    (RingHom.ker (aeval a : MvPolynomial σ K →ₐ[K] L)).IsPrime :=
  RingHom.ker_isPrime _

end V

/-- A system is satisfiable when it generates a proper ideal. By the weak Nullstellensatz
(`V_eq_empty_iff`) this is the same as having a solution over `K̄`. -/
def Sat (Q : Set (MvPolynomial σ K)) : Prop := Ideal.span Q ≠ ⊤

section Nullstellensatz

variable (L : Type*) [Field L] [Algebra K L] [IsAlgClosed L] [Finite σ]

/-- Hilbert's Nullstellensatz, `I(V(Q)) = √⟨Q⟩` (Preliminaries). -/
theorem vanishing_V_eq_radical (Q : Set (MvPolynomial σ K)) :
    {p : MvPolynomial σ K | ∀ a ∈ V L Q, aeval a p = 0} = ((Ideal.span Q).radical : Set _) := by
  have h := vanishingIdeal_zeroLocus_eq_radical (K := L) (Ideal.span Q)
  ext p
  have := SetLike.ext_iff.mp h p
  simp only [mem_vanishingIdeal_iff, mem_zeroLocus_iff] at this
  simpa [V_eq_zeroLocus] using this

/-- Weak Nullstellensatz: `V(Q) = ∅` exactly when `⟨Q⟩ = ⟨1⟩` (Preliminaries). -/
theorem V_eq_empty_iff (Q : Set (MvPolynomial σ K)) : V L Q = ∅ ↔ Ideal.span Q = ⊤ := by
  have h := Set.ext_iff.mp (vanishing_V_eq_radical L Q) 1
  simp only [Set.mem_ofPred_eq, map_one, one_ne_zero, SetLike.mem_coe] at h
  rw [← Ideal.radical_eq_top, Ideal.eq_top_iff_one, ← h, Set.eq_empty_iff_forall_notMem]

theorem sat_iff_V_nonempty (Q : Set (MvPolynomial σ K)) : Sat Q ↔ (V L Q).Nonempty := by
  rw [Sat, Ne, ← V_eq_empty_iff L, Set.nonempty_iff_ne_empty]

end Nullstellensatz

end FactorBranching
